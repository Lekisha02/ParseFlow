# ==============================================================================
# ParseX Environment Configuration
# ==============================================================================

# Multimodal Vision Model API Key (e.g., Google Gemini or compatible multimodal API)
# If provided, complex visual regions (diagrams, charts, handwriting) are sent
# to the cloud vision model for deep semantic parsing and transcription.
# If left blank, ParseX automatically falls back to the high-performance local
# OCR engine (RapidOCR / PP-OCRv4) + local CV contour & diagram analyzer.
VISION_API_KEY=

# Vision Provider: "gemini" (default) or "none" (forces local fallback)
VISION_PROVIDER=gemini

# Vision Model name (default: gemini-2.5-flash)
VISION_MODEL=gemini-2.5-flash

# Server Host & Port
PORT=8000
HOST=127.0.0.1
